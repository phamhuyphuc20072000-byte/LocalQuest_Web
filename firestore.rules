rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('role' in data) || data.role in ['tourist', 'host', 'admin']) &&
             (!('points' in data) || data.points is number) &&
             (!('completedQuests' in data) || data.completedQuests is list) &&
             (!('savedQuests' in data) || data.savedQuests is list) &&
             (!('badges' in data) || data.badges is list);
    }

    function isValidBooking(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.questId is string && data.questId.size() <= 128 &&
             data.bookingDate is string && data.bookingDate.size() <= 20 &&
             data.touristsCount is number && data.touristsCount > 0 && data.touristsCount <= 50 &&
             data.totalPriceVnd is number && data.totalPriceVnd >= 0;
    }

    // User Profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying all user profiles
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // Tour Bookings collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isSignedIn() && isValidId(bookingId) && existing().userId == request.auth.uid && isValidBooking(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
