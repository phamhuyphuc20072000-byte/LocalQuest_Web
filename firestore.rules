rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'phamhuyphuc20072000@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('role' in data) || data.role in ['tourist', 'guide', 'admin']) &&
             (!('points' in data) || data.points is number) &&
             (!('exp' in data) || data.exp is number) &&
             (!('localCoins' in data) || data.localCoins is number) &&
             (!('completedQuests' in data) || data.completedQuests is list) &&
             (!('savedQuests' in data) || data.savedQuests is list) &&
             (!('badges' in data) || data.badges is list) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50));
    }

    function isValidQuest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.city is string && data.city.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             (!('difficulty' in data) || (data.difficulty is string && data.difficulty.size() <= 50)) &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 100)) &&
             (!('story' in data) || (data.story is string && data.story.size() <= 4000)) &&
             (!('teaser' in data) || (data.teaser is string && data.teaser.size() <= 1000)) &&
             (!('waypoints' in data) || data.waypoints is list) &&
             (!('status' in data) || data.status in ['active', 'pending', 'rejected']);
    }

    function isValidTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ticketCode is string && data.ticketCode.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.qrPayload is string && data.qrPayload.size() <= 256 &&
             (!('status' in data) || data.status in ['valid', 'used', 'completed', 'expired', 'playing', 'SCHEDULED']);
    }

    function isValidGuideProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.city is string && data.city.size() <= 100 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('status' in data) || data.status in ['pending', 'verified', 'approved', 'rejected']);
    }

    function isValidWallet(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.guideId is string && data.guideId.size() <= 128 &&
             data.balanceVnd is number;
    }

    function isValidWalletTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.amount is number &&
             data.type in ['earning', 'withdrawal', 'bonus', 'refund'] &&
             data.description is string && data.description.size() <= 500;
    }

    function isValidWithdrawal(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.guideId is string && data.guideId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.bankName is string && data.bankName.size() <= 100 &&
             data.bankAccount is string && data.bankAccount.size() <= 50 &&
             (!('status' in data) || data.status in ['pending', 'approved', 'rejected']);
    }

    // 1. User Profiles collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // 2. Quests collection
    match /quests/{questId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(questId) && isValidQuest(incoming());
      allow update: if isSignedIn() && isValidId(questId) && isValidQuest(incoming());
      allow delete: if isSignedIn() && isValidId(questId);
    }

    // 3. Tickets collection
    match /tickets/{ticketId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        !('buyerId' in resource.data) ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming());
      allow delete: if isSignedIn() && isValidId(ticketId);
    }

    // 4. Guides collection
    match /guides/{guideId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(guideId) && isValidGuideProfile(incoming());
      allow update: if isSignedIn() && isValidId(guideId) && isValidGuideProfile(incoming());
      allow delete: if isSignedIn() && isValidId(guideId);
    }

    // 5. Wallets and Transactions
    match /wallets/{guideId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(guideId) && isValidWallet(incoming());
      
      match /transactions/{txId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(txId) && isValidWalletTransaction(incoming());
        allow update, delete: if false;
      }
    }

    // 6. Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawal(incoming());
      allow update: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawal(incoming());
      allow delete: if isSignedIn() && isValidId(withdrawalId);
    }
  }
}
